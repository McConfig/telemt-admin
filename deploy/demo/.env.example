# Пароль Valkey внутри демо-сети. Можно оставить как есть: порт наружу не
# публикуется.
VALKEY_PASSWORD=demo-valkey-password

# Токен между tgadmin и фейковым telemt.
TELEMT_API_TOKEN=demo-token

# Домен в демонстрационных ссылках tg://. Реальный прокси не используется.
DEMO_DOMAIN=demo.example.com

# Версия образа tgadmin.
TGADMIN_VERSION=v1.1.9

# Пароли пользователей интерфейса, которые создаёт seed.
DEMO_ADMIN_PASSWORD=demo-admin-password
DEMO_VIEWER_PASSWORD=demo-viewer-password
